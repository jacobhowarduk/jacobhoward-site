/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Keep the *.workers.dev preview out of search results so it doesn't compete
# with jacobhoward.co.uk for the same content. Never applies to the real domain.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

/assets/papers/*
  Cache-Control: public, max-age=86400
